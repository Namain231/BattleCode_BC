+<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 820 336" font-family="Helvetica, Arial, sans-serif" role="img" aria-labelledby="t">
+<title id="t">How the teacher and student run as sidecars and save resumable checkpoints</title>
+<defs><marker id="flow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto"><path d="M0 0L10 5L0 10z" fill="#263d31"/></marker><marker id="back" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto"><path d="M0 0L10 5L0 10z" fill="#b53b13"/></marker><marker id="dim" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto"><path d="M0 0L10 5L0 10z" fill="#66675e"/></marker></defs>
+<rect width="820" height="336" fill="#ede5d5"/>
+<text x="40" y="40" font-size="20" font-weight="bold" fill="#20251f" text-anchor="start">Teacher and student side by side</text>
+<text x="40" y="64" font-size="13" font-weight="normal" fill="#66675e" text-anchor="start">On separate GPUs they run together. On one 16 GB card the same two jobs alternate.</text>
+<rect x="40" y="100" width="220" height="118" rx="8" fill="#263d31" stroke="#263d31" stroke-width="1.5"/><text x="54" y="125" font-size="15" font-weight="bold" fill="#ede5d5" text-anchor="start">Teacher</text><text x="54" y="146" font-size="12.5" font-weight="normal" fill="#ede5d5" text-anchor="start">PPO rollouts and two epochs</text><text x="54" y="164" font-size="12.5" font-weight="normal" fill="#ede5d5" text-anchor="start">latest.pt every 5 updates</text><text x="54" y="182" font-size="12.5" font-weight="normal" fill="#ede5d5" text-anchor="start">snapshot every 25 by default</text><text x="54" y="200" font-size="12.5" font-weight="normal" fill="#ede5d5" text-anchor="start">save again on exit or SIGTERM</text>
+<rect x="300" y="100" width="220" height="118" rx="8" fill="#2f7f79" stroke="#2f7f79" stroke-width="1.5"/><text x="314" y="125" font-size="15" font-weight="bold" fill="#ede5d5" text-anchor="start">Student sidecar</text><text x="314" y="146" font-size="12.5" font-weight="normal" fill="#ede5d5" text-anchor="start">copy the newest latest.pt</text><text x="314" y="164" font-size="12.5" font-weight="normal" fill="#ede5d5" text-anchor="start">distil for 15 minutes</text><text x="314" y="182" font-size="12.5" font-weight="normal" fill="#ede5d5" text-anchor="start">finish quantisation-aware</text><text x="314" y="200" font-size="12.5" font-weight="normal" fill="#ede5d5" text-anchor="start">keep round-HHMM.pt</text>
+<rect x="560" y="100" width="220" height="118" rx="8" fill="#f6f1e7" stroke="#b9ad99" stroke-width="1.5"/><text x="574" y="125" font-size="15" font-weight="bold" fill="#20251f" text-anchor="start">Evaluations</text><text x="574" y="146" font-size="12.5" font-weight="normal" fill="#66675e" text-anchor="start">each round snapshot is immutable</text><text x="574" y="164" font-size="12.5" font-weight="normal" fill="#66675e" text-anchor="start">fleet games against the foil</text><text x="574" y="182" font-size="12.5" font-weight="normal" fill="#66675e" text-anchor="start">encoder, action and points gates</text>
+<path d="M262 159 L296 159" fill="none" stroke="#263d31" stroke-width="2.2" stroke-linejoin="round" marker-end="url(#flow)"/>
