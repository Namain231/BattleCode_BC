+<path d="M500 272.0 L522 272.0" fill="none" stroke="#263d31" stroke-width="2.2" stroke-linejoin="round" marker-end="url(#flow)"/>
+<path d="M632.0 176 L632.0 196 L148.0 196 L148.0 214" fill="none" stroke="#263d31" stroke-width="2.2" stroke-linejoin="round" marker-end="url(#flow)"/>
+<path d="M632.0 328 L632.0 366" fill="none" stroke="#263d31" stroke-width="2.2" stroke-linejoin="round" marker-end="url(#flow)"/>
+<rect x="524" y="368" width="216" height="96" rx="8" fill="#dcd0bb" stroke="#b9ad99" stroke-width="1.5"/><text x="538" y="393" font-size="15" font-weight="bold" fill="#20251f" text-anchor="start">The action</text><text x="538" y="414" font-size="12.5" font-weight="normal" fill="#66675e" text-anchor="start">a move, a sprint or a split;</text><text x="538" y="432" font-size="12.5" font-weight="normal" fill="#66675e" text-anchor="start">with none, a safe fallback</text>
+<path d="M522 416 L500 416" fill="none" stroke="#263d31" stroke-width="2.2" stroke-linejoin="round" marker-end="url(#flow)"/>
+<rect x="282" y="368" width="216" height="96" rx="8" fill="#2f7f79" stroke="#2f7f79" stroke-width="1.5"/><text x="296" y="393" font-size="15" font-weight="bold" fill="#ede5d5" text-anchor="start">Radio</text><text x="296" y="414" font-size="12.5" font-weight="normal" fill="#ede5d5" text-anchor="start">one frame on each of the</text><text x="296" y="432" font-size="12.5" font-weight="normal" fill="#ede5d5" text-anchor="start">four rays, for whoever</text><text x="296" y="450" font-size="12.5" font-weight="normal" fill="#ede5d5" text-anchor="start">each reaches first</text>
+<path d="M280 416 L258 416" fill="none" stroke="#b53b13" stroke-width="2.2" stroke-dasharray="7 5" stroke-linejoin="round" marker-end="url(#back)"/>
+<rect x="40" y="368" width="216" height="96" rx="8" fill="#f6f1e7" stroke="#b9ad99" stroke-width="1.5"/><text x="54" y="393" font-size="15" font-weight="bold" fill="#20251f" text-anchor="start">Teammates</text><text x="54" y="414" font-size="12.5" font-weight="normal" fill="#66675e" text-anchor="start">read the frames at their</text><text x="54" y="432" font-size="12.5" font-weight="normal" fill="#66675e" text-anchor="start">next turn, into their own</text><text x="54" y="450" font-size="12.5" font-weight="normal" fill="#66675e" text-anchor="start">world model</text>
