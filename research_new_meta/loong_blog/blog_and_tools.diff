+<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1020 386" font-family="Helvetica, Arial, sans-serif" role="img" aria-labelledby="t">
+<title id="t">How bot versions and library pieces become immutable</title>
+<defs><marker id="a" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0L10 5L0 10z" fill="#66675e"/></marker><marker id="s" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0L10 5L0 10z" fill="#b53b13"/></marker></defs>
+<rect width="1020" height="386" fill="#ede5d5"/>
+<text x="20" y="30" font-size="17" fill="#20251f" text-anchor="start" font-weight="bold">A version becomes evidence once it plays</text>
