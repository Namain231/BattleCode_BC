+<rect x="270" y="52" width="220" height="112" rx="8" fill="#263d31" stroke="#b53b13" stroke-width="1.6"/><text x="284" y="77" font-size="15" fill="#ede5d5" text-anchor="start" font-weight="bold">Freeze</text><text x="284" y="98" font-size="12.5" fill="#d9d2c3" text-anchor="start" font-weight="normal">make the source immutable</text><text x="284" y="116" font-size="12.5" fill="#d9d2c3" text-anchor="start" font-weight="normal">keep its identifier</text>
+<path d="M242 108 L268 108" fill="none" stroke="#66675e" stroke-width="1.8" stroke-linejoin="round" marker-end="url(#a)"/>
+<rect x="520" y="52" width="220" height="112" rx="8" fill="#f6f1e7" stroke="#b9ad99" stroke-width="1.6"/><text x="534" y="77" font-size="15" fill="#20251f" text-anchor="start" font-weight="bold">Build</text><text x="534" y="98" font-size="12.5" fill="#66675e" text-anchor="start" font-weight="normal">pin every library piece</text><text x="534" y="116" font-size="12.5" fill="#66675e" text-anchor="start" font-weight="normal">register the WebAssembly</text>
+<path d="M492 108 L518 108" fill="none" stroke="#66675e" stroke-width="1.8" stroke-linejoin="round" marker-end="url(#a)"/>
+<rect x="770" y="52" width="220" height="112" rx="8" fill="#f6f1e7" stroke="#b9ad99" stroke-width="1.6"/><text x="784" y="77" font-size="15" fill="#20251f" text-anchor="start" font-weight="bold">Keep</text><text x="784" y="98" font-size="12.5" fill="#66675e" text-anchor="start" font-weight="normal">replay provenance</text><text x="784" y="116" font-size="12.5" fill="#66675e" text-anchor="start" font-weight="normal">opponent and regression test</text>
