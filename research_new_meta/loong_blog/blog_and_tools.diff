+<rect x="40" y="370" width="740" height="72" rx="8" fill="#f6f1e7" stroke="#a8801a" stroke-width="2"/>
+<rect x="40" y="370" width="10" height="72" rx="3" fill="#a8801a"/>
+<text x="66" y="398" font-size="16" font-weight="bold" fill="#20251f" text-anchor="start">4. Scouts</text>
+<text x="66" y="420" font-size="13" font-weight="normal" fill="#66675e" text-anchor="start">a third</text>
+<text x="250" y="394" font-size="13.5" font-weight="normal" fill="#20251f" text-anchor="start">while unseen board is left,</text>
+<text x="250" y="413" font-size="13.5" font-weight="normal" fill="#20251f" text-anchor="start">with 2 or more units</text>
