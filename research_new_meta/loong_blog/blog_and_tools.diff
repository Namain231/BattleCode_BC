+<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1020 486" font-family="Helvetica, Arial, sans-serif" role="img" aria-labelledby="t">
+<title id="t">How a numbered bot, pinned library pieces and the runtime become one registered build</title>
+<defs><marker id="a" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0L10 5L0 10z" fill="#66675e"/></marker><marker id="s" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0L10 5L0 10z" fill="#b53b13"/></marker></defs>
+<rect width="1020" height="486" fill="#ede5d5"/>
+<text x="20" y="30" font-size="17" fill="#20251f" text-anchor="start" font-weight="bold">A bot is an assembly, not a copy of the whole library</text>
+<rect x="20" y="56" width="250" height="112" rx="8" fill="#263d31" stroke="#b9ad99" stroke-width="1.6"/><text x="34" y="81" font-size="15" fill="#ede5d5" text-anchor="start" font-weight="bold">main/NNNN</text><text x="34" y="102" font-size="12.5" fill="#d9d2c3" text-anchor="start" font-weight="normal">strategy.nim</text><text x="34" y="120" font-size="12.5" fill="#d9d2c3" text-anchor="start" font-weight="normal">library.toml</text>
+<rect x="20" y="194" width="250" height="112" rx="8" fill="#f6f1e7" stroke="#b9ad99" stroke-width="1.6"/><text x="34" y="219" font-size="15" fill="#20251f" text-anchor="start" font-weight="bold">The catalogues</text><text x="34" y="240" font-size="12.5" fill="#66675e" text-anchor="start" font-weight="normal">this line&#x27;s lib/</text><text x="34" y="258" font-size="12.5" fill="#66675e" text-anchor="start" font-weight="normal">common/lib/</text>
+<rect x="350" y="102" width="250" height="144" rx="8" fill="#f6f1e7" stroke="#a8801a" stroke-width="1.6"/><text x="364" y="127" font-size="15" fill="#20251f" text-anchor="start" font-weight="bold">Materialise</text><text x="364" y="148" font-size="12.5" fill="#66675e" text-anchor="start" font-weight="normal">read the manifest</text><text x="364" y="166" font-size="12.5" fill="#66675e" text-anchor="start" font-weight="normal">copy only its pinned pieces</text><text x="364" y="184" font-size="12.5" fill="#66675e" text-anchor="start" font-weight="normal">mount one repertoire/</text>
+<rect x="680" y="56" width="310" height="112" rx="8" fill="#f6f1e7" stroke="#b9ad99" stroke-width="1.6"/><text x="694" y="81" font-size="15" fill="#20251f" text-anchor="start" font-weight="bold">Assembled source</text><text x="694" y="102" font-size="12.5" fill="#66675e" text-anchor="start" font-weight="normal">strategy.nim</text><text x="694" y="120" font-size="12.5" fill="#66675e" text-anchor="start" font-weight="normal">repertoire/ with stable imports</text>
+<rect x="680" y="194" width="310" height="112" rx="8" fill="#f6f1e7" stroke="#b9ad99" stroke-width="1.6"/><text x="694" y="219" font-size="15" fill="#20251f" text-anchor="start" font-weight="bold">common/runtime</text><text x="694" y="240" font-size="12.5" fill="#66675e" text-anchor="start" font-weight="normal">entry point and judge boundary</text><text x="694" y="258" font-size="12.5" fill="#66675e" text-anchor="start" font-weight="normal">shared, but separately snapshotted</text>
+<rect x="680" y="350" width="310" height="112" rx="8" fill="#f6f1e7" stroke="#b53b13" stroke-width="1.6"/><text x="694" y="375" font-size="15" fill="#20251f" text-anchor="start" font-weight="bold">Registered build</text><text x="694" y="396" font-size="12.5" fill="#66675e" text-anchor="start" font-weight="normal">WebAssembly</text><text x="694" y="414" font-size="12.5" fill="#66675e" text-anchor="start" font-weight="normal">source and toolchain hashes</text>
+<path d="M270 112 L320 112 L320 150 L348 150" fill="none" stroke="#66675e" stroke-width="1.8" stroke-linejoin="round" marker-end="url(#a)"/>
+<path d="M270 250 L320 250 L320 200 L348 200" fill="none" stroke="#66675e" stroke-width="1.8" stroke-linejoin="round" marker-end="url(#a)"/>
+<path d="M600 174 L640 174 L640 112 L678 112" fill="none" stroke="#66675e" stroke-width="1.8" stroke-linejoin="round" marker-end="url(#a)"/>
+<path d="M990 112 L1005 112 L1005 406 L992 406" fill="none" stroke="#66675e" stroke-width="1.8" stroke-linejoin="round" marker-end="url(#a)"/>
+<path d="M835 306 L835 348" fill="none" stroke="#66675e" stroke-width="1.8" stroke-linejoin="round" marker-end="url(#a)"/>
+<text x="20" y="346" font-size="13" fill="#66675e" text-anchor="start" font-weight="normal">library.toml chooses versions; it does not describe the turn loop.</text>
+<text x="20" y="369" font-size="13" fill="#66675e" text-anchor="start" font-weight="normal">strategy.nim and the selected pieces own that decision structure.</text>
+</svg>
