+<text x="250" y="186" font-size="13.5" font-weight="normal" fill="#20251f" text-anchor="start">the whole team</text>
+<text x="530" y="148" font-size="13.5" font-weight="bold" fill="#20251f" text-anchor="start">the longest</text>
+<rect x="40" y="206" width="740" height="72" rx="8" fill="#f6f1e7" stroke="#263d31" stroke-width="2"/>
+<rect x="40" y="206" width="10" height="72" rx="3" fill="#263d31"/>
+<text x="66" y="234" font-size="16" font-weight="bold" fill="#20251f" text-anchor="start">2. Understudy</text>
+<text x="66" y="256" font-size="13" font-weight="normal" fill="#66675e" text-anchor="start">one</text>
+<text x="250" y="230" font-size="13.5" font-weight="normal" fill="#20251f" text-anchor="start">from round 350, with a champion</text>
+<text x="250" y="249" font-size="13.5" font-weight="normal" fill="#20251f" text-anchor="start">and 3 or more units</text>
+<text x="530" y="230" font-size="13.5" font-weight="bold" fill="#20251f" text-anchor="start">the next longest,</text>
+<text x="530" y="249" font-size="13.5" font-weight="bold" fill="#20251f" text-anchor="start">8 or more</text>
+<rect x="40" y="288" width="740" height="72" rx="8" fill="#f6f1e7" stroke="#2f7f79" stroke-width="2"/>
+<rect x="40" y="288" width="10" height="72" rx="3" fill="#2f7f79"/>
+<text x="66" y="316" font-size="16" font-weight="bold" fill="#20251f" text-anchor="start">3. Escort</text>
+<text x="66" y="338" font-size="13" font-weight="normal" fill="#66675e" text-anchor="start">one</text>
+<text x="250" y="312" font-size="13.5" font-weight="normal" fill="#20251f" text-anchor="start">with a champion and 4 or more</text>
+<text x="250" y="331" font-size="13.5" font-weight="normal" fill="#20251f" text-anchor="start">units</text>
+<text x="530" y="312" font-size="13.5" font-weight="bold" fill="#20251f" text-anchor="start">the nearest, 4 or more</text>
