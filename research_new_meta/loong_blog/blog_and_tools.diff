+<rect x="540" y="270" width="220" height="92" rx="8" fill="#f6f1e7" stroke="#b9ad99" stroke-width="1.6"/><text x="554" y="295" font-size="15" fill="#20251f" text-anchor="start" font-weight="bold">0003.rk</text><text x="554" y="316" font-size="12.5" fill="#66675e" text-anchor="start" font-weight="normal">the measured hot kernel</text>
